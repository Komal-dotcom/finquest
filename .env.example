# GEMINI_API_KEY: Required for Gemini AI API calls (FinBot AI Advisor).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT Secret for Auth Token Signing
JWT_SECRET="finquest_secret_jwt_key_2026"

# Optional MongoDB connection URI (app defaults to built-in JSON file database if empty)
MONGO_URI=""

# Optional OpenAI API Key if preferred for FinBot
OPENAI_API_KEY=""

# Server Port (default 3000)
PORT=3000
